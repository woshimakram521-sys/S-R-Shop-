<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f766e" />
      <stop offset="100%" stop-color="#115e59" />
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#042f2e" flood-opacity="0.35" />
    </filter>
  </defs>
  <!-- Background with clay/squircle shape -->
  <rect width="512" height="512" rx="128" fill="url(#grad)" />
  <!-- Inner soft gloss highlight -->
  <rect x="24" y="24" width="464" height="240" rx="104" fill="white" fill-opacity="0.08" />
  <!-- Nova Shop 'N' & Shopping Bag 3D motif -->
  <g filter="url(#shadow)">
    <path d="M160 180 C160 130 352 130 352 180" stroke="#f59e0b" stroke-width="28" stroke-linecap="round" fill="none" />
    <rect x="128" y="180" width="256" height="220" rx="40" fill="#ffffff" />
    <path d="M190 230 L190 350 L240 280 L272 350 L272 230" fill="none" stroke="#0f766e" stroke-width="24" stroke-linecap="round" stroke-linejoin="round" />
    <!-- Bangadesh Star / Sparkle in Amber -->
    <path d="M340 230 L345 245 L360 250 L345 255 L340 270 L335 255 L320 250 L335 245 Z" fill="#f59e0b" />
  </g>
</svg>